generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum DebitCredit {
  S
  H
}

enum AccountType {
  KASSE
  TRANSIT
  GEGENKONTO
}

enum BookingDateMode {
  TODAY
  EMPTY
}

enum FieldSource {
  BOOKING_FIELD
  CONSTANT
}

enum BookingField {
  BOOKING_DATE
  RECEIPT_NUMBER
  AMOUNT
  DEBIT_CREDIT
  ACCOUNT_NUMBER
  ACCOUNT_NAME
  COUNTER_ACCOUNT_NUMBER
  COUNTER_ACCOUNT_NAME
  COST_CENTER_CODE
  COST_CENTER_NAME
  DESCRIPTION
  TAX_KEY
  BELEGART_CODE
  BELEGART_LABEL
  SCHOOL_NAME
  SCHOOL_CODE
  DMS_MANDANTEN_NR
  DATEV_MANDANTEN_NR
  CREATED_BY
  FILE_INDEX
}

enum FieldFormat {
  RAW
  DATE_DDMMYYYY
  DATE_ISO
  DATE_YYYYMMDD
  NUMBER_DE
  NUMBER_DE_CURRENCY
  NUMBER_DOT
  UPPER
  LOWER
}

model School {
  id                       String   @id @default(uuid())
  name                     String
  code                     String   @unique
  address                  String?
  kasseAccountId           String?  @map("kasse_account_id")
  anfangsbestandAccountId  String?  @map("anfangsbestand_account_id")
  kassendifferenzAccountId String?  @map("kassendifferenz_account_id")
  defaultBookingDateMode   BookingDateMode @default(TODAY) @map("default_booking_date_mode")
  dmsMandantenNummer       String?  @map("dms_mandanten_nummer")
  belegartDefaultId        String?  @map("belegart_default_id")
  belegartRequired         Boolean  @default(false) @map("belegart_required")
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  kasseAccount           Account?       @relation("SchoolKasse", fields: [kasseAccountId], references: [id])
  anfangsbestandAccount  Account?       @relation("SchoolAnfangsbestand", fields: [anfangsbestandAccountId], references: [id])
  kassendifferenzAccount Account?       @relation("SchoolKassendifferenz", fields: [kassendifferenzAccountId], references: [id])
  belegartDefault        Belegart?      @relation("SchoolBelegartDefault", fields: [belegartDefaultId], references: [id])
  users                  User[]
  bookings               Booking[]
  dailyClosings          DailyClosing[]
  receiptSeq             ReceiptSequence[]
  belegarten             Belegart[]     @relation("SchoolBelegarten")
  dmsFieldMappings       DmsFieldMapping[]

  @@map("schools")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role             UserRole @default(USER)
  schoolId         String?  @map("school_id")
  tableColumnOrder Json?    @map("table_column_order")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  school   School?    @relation(fields: [schoolId], references: [id])
  bookings Booking[]  @relation("BookingCreator")
  stornos  Booking[]  @relation("BookingStornoBy")
  closings DailyClosing[]
  auditLogs AuditLog[]
  uploadedReceipts BookingReceipt[] @relation("ReceiptUploader")

  @@map("users")
}

model Account {
  id                   String      @id @default(uuid())
  accountNumber        String      @map("account_number")
  name                 String
  description          String?
  type                 AccountType
  defaultCostCenterId  String?     @map("default_cost_center_id")
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  defaultCostCenter        CostCenter? @relation("AccountDefaultCostCenter", fields: [defaultCostCenterId], references: [id])
  bookingsAsAccount        Booking[] @relation("BookingAccount")
  bookingsAsCounterAccount Booking[] @relation("BookingCounterAccount")
  assignedSchools            School[] @relation("SchoolKasse")
  anfangsbestandForSchools   School[] @relation("SchoolAnfangsbestand")
  kassendifferenzForSchools  School[] @relation("SchoolKassendifferenz")

  @@unique([accountNumber, type])
  @@map("accounts")
}

model CostCenter {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bookings           Booking[]
  defaultForAccounts Account[] @relation("AccountDefaultCostCenter")

  @@map("cost_centers")
}

model Booking {
  id              String      @id @default(uuid())
  schoolId        String      @map("school_id")
  receiptNumber   Int         @map("receipt_number")
  bookingDate     DateTime    @map("booking_date") @db.Date
  amount          Decimal     @db.Decimal(12, 2)
  debitCredit     DebitCredit @map("debit_credit")
  accountId       String      @map("account_id")
  counterAccountId String     @map("counter_account_id")
  costCenterId    String?     @map("cost_center_id")
  description     String
  taxKey          String?     @map("tax_key")
  isStorno        Boolean     @default(false) @map("is_storno")
  stornoOfId      String?     @map("storno_of_id")
  stornoById      String?     @map("storno_by_id")
  isFinalized     Boolean     @default(false) @map("is_finalized")
  splitGroupId    String?     @map("split_group_id")
  createdById     String      @map("created_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  school         School      @relation(fields: [schoolId], references: [id])
  account        Account     @relation("BookingAccount", fields: [accountId], references: [id])
  counterAccount Account     @relation("BookingCounterAccount", fields: [counterAccountId], references: [id])
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id])
  createdBy      User        @relation("BookingCreator", fields: [createdById], references: [id])
  stornoBy       User?       @relation("BookingStornoBy", fields: [stornoById], references: [id])
  stornoOf       Booking?      @relation("BookingStorno", fields: [stornoOfId], references: [id])
  stornoBookings Booking[]     @relation("BookingStorno")
  dailyClosingCorrection DailyClosing? @relation("DailyClosingCorrection")
  receipts       BookingReceipt[]

  @@index([schoolId, bookingDate])
  @@index([schoolId, isFinalized])
  @@index([splitGroupId])
  @@map("bookings")
}

model Belegart {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  code      String
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school                School           @relation("SchoolBelegarten", fields: [schoolId], references: [id], onDelete: Cascade)
  defaultForSchools     School[]         @relation("SchoolBelegartDefault")
  receipts              BookingReceipt[]

  @@unique([schoolId, code])
  @@index([schoolId, sortOrder])
  @@map("belegarten")
}

model DmsFieldMapping {
  id                 String       @id @default(uuid())
  schoolId           String       @map("school_id")
  source             FieldSource
  bookingField       BookingField?
  constantValue      String?      @map("constant_value")
  dmsKey             String       @map("dms_key")
  format             FieldFormat?
  maxLength          Int?         @map("max_length")
  sortOrder          Int          @default(0) @map("sort_order")
  isActive           Boolean      @default(true) @map("is_active")
  includeOnSeparator Boolean      @default(true) @map("include_on_separator")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, dmsKey])
  @@index([schoolId, sortOrder])
  @@map("dms_field_mappings")
}

model BookingReceipt {
  id           String    @id @default(uuid())
  bookingId    String    @map("booking_id")
  belegartId   String?   @map("belegart_id")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  storagePath  String    @map("storage_path")
  sha256       String
  pageCount    Int?      @map("page_count")
  uploadedById String    @map("uploaded_by_id")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  deletedAt    DateTime? @map("deleted_at")

  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  belegart   Belegart? @relation(fields: [belegartId], references: [id])
  uploadedBy User      @relation("ReceiptUploader", fields: [uploadedById], references: [id])

  @@index([bookingId])
  @@index([sha256])
  @@map("booking_receipts")
}

model ReceiptSequence {
  id        String @id @default(uuid())
  schoolId  String @unique @map("school_id")
  lastNumber Int   @default(0) @map("last_number")

  school School @relation(fields: [schoolId], references: [id])

  @@map("receipt_sequences")
}

model DailyClosing {
  id                  String   @id @default(uuid())
  schoolId            String   @map("school_id")
  closingDate         DateTime @map("closing_date") @db.Date
  expectedBalance     Decimal  @map("expected_balance") @db.Decimal(12, 2)
  actualBalance       Decimal  @map("actual_balance") @db.Decimal(12, 2)
  difference          Decimal  @db.Decimal(12, 2)
  closedById          String   @map("closed_by_id")
  comment             String?  @map("comment")
  correctionBookingId String?  @unique @map("correction_booking_id")
  denominationCounts  Json?    @map("denomination_counts")
  createdAt           DateTime @default(now()) @map("created_at")

  school             School   @relation(fields: [schoolId], references: [id])
  closedBy           User     @relation(fields: [closedById], references: [id])
  correctionBooking  Booking? @relation("DailyClosingCorrection", fields: [correctionBookingId], references: [id])

  @@unique([schoolId, closingDate])
  @@map("daily_closings")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DatevExportConfig {
  id               String @id @default(uuid())
  beraterNummer    String @map("berater_nummer")
  mandantenNummer  String @map("mandanten_nummer")
  wirtschaftsjahrBeginn String @map("wirtschaftsjahr_beginn")
  sachkontenLaenge Int    @default(4) @map("sachkonten_laenge")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("datev_export_config")
}

/// Marker: haelt fest, dass diese Mandanten-Datenbank initial geseedet wurde.
/// Genau eine Zeile mit id = "default". Bewusst eine eigene Tabelle und kein
/// aus Stammdaten abgeleitetes Signal — Stammdaten sind in der UI editier- und
/// loeschbar und taugen deshalb nicht als Initialisierungs-Nachweis.
model SeedState {
  id       String   @id
  seededAt DateTime @default(now()) @map("seeded_at")

  @@map("seed_state")
}
